<html lang='en'>
  <body
    style='margin:0;padding:0;background:#f8fafc;font-family:Arial,Helvetica,sans-serif;color:#111827;'
  >
    <table
      role='presentation'
      width='100%'
      cellspacing='0'
      cellpadding='0'
      style='background:#f8fafc;'
    >
      <tr>
        <td align='center' style='padding:40px 16px;'>
          <table
            role='presentation'
            width='100%'
            cellspacing='0'
            cellpadding='0'
            style='max-width:640px;background:#ffffff;border:1px solid #e2e8f0;border-radius:24px;overflow:hidden;box-shadow:0 20px 50px rgba(15,23,42,0.08);'
          >
            <tr>
              <td style='padding:30px 36px 24px;background:#0f172a;'>
                <span
                  style='display:inline-block;width:40px;height:40px;border-radius:12px;background:{{#if isApproved}}#10b981{{else}}#ef4444{{/if}};text-align:center;line-height:40px;color:#ffffff;font-size:18px;font-weight:700;'
                >{{#if isApproved}}✓{{else}}✕{{/if}}</span>
                <span
                  style='float:right;border:1px solid rgba(255,255,255,0.20);border-radius:999px;color:{{#if isApproved}}#a7f3d0{{else}}#fecaca{{/if}};font-size:12px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;padding:8px 12px;'
                >{{#if isApproved}}Refund Approved{{else}}Refund Declined{{/if}}</span>
              </td>
            </tr>
            <tr>
              <td style='padding:36px 36px 14px;'>
                <h1
                  style='margin:0;color:#111827;font-size:26px;line-height:34px;font-weight:800;'
                >{{#if isApproved}}Your Refund Has Been Processed{{else}}Update on Your Refund Request{{/if}}</h1>
                <p
                  style='margin:16px 0 0;color:#4b5563;font-size:15px;line-height:24px;'
                >Hi {{customerEmail}}, we have reviewed your refund request for order <strong>#{{orderNumber}}</strong>.</p>
              </td>
            </tr>
            <tr>
              <td style='padding:0 36px 20px;'>
                <table
                  role='presentation'
                  width='100%'
                  cellspacing='0'
                  cellpadding='12'
                  style='background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;font-size:14px;'
                >
                  <tr>
                    <td style='color:#64748b;width:35%;'>Order Number:</td>
                    <td style='font-weight:600;color:#0f172a;'>#{{orderNumber}}</td>
                  </tr>
                  <tr>
                    <td style='color:#64748b;'>Status:</td>
                    <td style='font-weight:700;color:{{#if isApproved}}#059669{{else}}#dc2626{{/if}};'>
                      {{#if isApproved}}APPROVED{{else}}DECLINED{{/if}}
                    </td>
                  </tr>
                  {{#if isApproved}}
                  <tr>
                    <td style='color:#64748b;'>Refunded Amount:</td>
                    <td style='font-weight:700;color:#059669;'>{{amount}} {{currency}}</td>
                  </tr>
                  {{/if}}
                  {{#if adminNote}}
                  <tr>
                    <td style='color:#64748b;vertical-align:top;'>Note from Team:</td>
                    <td style='color:#334155;font-style:italic;'>&ldquo;{{adminNote}}&rdquo;</td>
                  </tr>
                  {{/if}}
                </table>
              </td>
            </tr>
            {{#if isApproved}}
            <tr>
              <td style='padding:0 36px 20px;'>
                <div style='background:#ecfdf5;border:1px solid #a7f3d0;border-radius:12px;padding:14px 16px;color:#065f46;font-size:13px;line-height:20px;'>
                  <strong>When will I see the funds?</strong><br/>
                  Refunds are sent immediately to your payment card/method via our payment provider. Depending on your bank or card issuer, it usually takes <strong>5 to 10 business days</strong> for the credit to appear on your statement.
                </div>
              </td>
            </tr>
            {{/if}}
            <tr>
              <td style='padding:10px 36px 24px;'>
                <a
                  href='{{clientUrl}}'
                  target='_blank'
                  style='display:inline-block;padding:14px 28px;background:#0f172a;color:#ffffff;font-size:14px;font-weight:700;text-decoration:none;border-radius:12px;'
                >View Your Account</a>
              </td>
            </tr>
            <tr>
              <td style='padding:20px 36px;background:#f8fafc;border-top:1px solid #e2e8f0;color:#94a3b8;font-size:12px;'>
                If you have questions about this transaction, please reply directly to this email.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
